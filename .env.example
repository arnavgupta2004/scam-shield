# Copy to .env and fill in. Never commit .env.

# watsonx Orchestrate instance (Settings -> API details)
WO_INSTANCE=https://api.ap-south-1.dl.watson-orchestrate.ibm.com/instances/your-instance-id
WO_API_KEY=your_api_key_here
# Token endpoint. Default works for IBM SaaS (AWS) instances.
# For IBM Cloud instances use: https://iam.cloud.ibm.com/identity/token
# WO_AUTH_URL=https://account-iam.platform.saas.ibm.com/api/2.0/apikeys/token

# Agent ids: run `python backend/agent_ids.py` to print these
TRIAGE_AGENT_ID=
GUARDIAN_AGENT_ID=
REPORT_AGENT_ID=
# Optional: call scam_analyst directly instead of the triage supervisor (faster)
# ANALYSE_AGENT_ID=

# Seconds to wait for an agent before using the offline fallback
WO_TIMEOUT=60
